# Copy to infra/.env for local Docker Compose development. NEVER commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-random-64-char-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
POSTGRES_DB=pocket_cfo
POSTGRES_USER=pocket_cfo
POSTGRES_PASSWORD=replace-with-strong-db-password
PGSSLMODE=prefer
CORS_ALLOWED_ORIGINS=https://app.pocketcfo.app
